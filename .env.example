# ==============================================================================
# 🔑 AGENTIC AI PROJECT - API KEYS & CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Duplicate this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL MODEL & OLLAMA CONFIGURATION
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
REASONING_MODEL=llama3.2:latest
ANALYSIS_MODEL=qwen2.5:latest
EMBEDDING_MODEL=nomic-embed-text:latest

# ------------------------------------------------------------------------------
# 2. COMMERCIAL LLM PROVIDER API KEYS
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4, o1, o3, Embeddings)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (Gemini 1.5 Pro, Gemini 1.5 Flash, Gemini 2.0)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Groq (Ultra-fast Llama 3, Mixtral inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI (Mistral Large, Codestral, Mistral Embeddings)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# DeepSeek (DeepSeek-V3, DeepSeek-R1)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Cohere (Command R+, Embed, Rerank)
# Get your key at: https://dashboard.cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# Perplexity AI (Sonar Reasoning, Online Search LLM)
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenRouter (Unified router for multiple model providers)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. AGENT OBSERVABILITY & TRACING
# ------------------------------------------------------------------------------
# LangSmith / LangChain tracing for inspecting agent reasoning steps
# Get your key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=agentic-ai-project
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Langfuse (Open-source LLM engineering platform)
# Get your key at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 4. WEB SEARCH & RESEARCH TOOLS
# ------------------------------------------------------------------------------
# Tavily Search API (Optimized for AI agents and RAG)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# SerpAPI (Google Search, News, Finance scraper)
# Get your key at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Serper API (Fast Google Search API)
# Get your key at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Brave Search API
# Get your key at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Firecrawl (Web scraping & markdown conversion for LLMs)
# Get your key at: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# 5. FINANCIAL & MARKET DATA APIS (FOR STOCK AGENTS)
# ------------------------------------------------------------------------------
# Finnhub Stock API (Real-time quotes, company profiles, filings)
# Get your key at: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage (Stock quotes, technical indicators, historical prices)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon.io (Real-time market data & financial statements)
# Get your key at: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here

# Financial Modeling Prep (FMP) (Balance sheets, earnings, metrics)
# Get your key at: https://site.financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# ------------------------------------------------------------------------------
# 6. VECTOR DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Pinecone (Managed vector database)
# Get your key at: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1

# Qdrant (Vector database)
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=https://your-cluster-url.qdrant.io

# ------------------------------------------------------------------------------
# 7. APPLICATION & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
VECTOR_STORE_TYPE=faiss
DATA_DIR=./data
PERSIST_DIRECTORY=./data/vector_store
TRACE_DIR=./data/traces
